{
  "openapi": "3.0.3",
  "info": {
    "title": "Shopify & WooCommerce Catalog + 301 Redirect Generator (Apify Cloud API)",
    "description": "Extracts complete product catalogues and generates 100% SEO-safe 301 redirect CSV mappings for Shopify, WooCommerce, and BigCommerce replatforming.\n\nRapidAPI Cloud Integration powered by Apify Pay-Per-Event (PPE).\nUnit Execution Price: $0.050 USD.",
    "version": "1.0.0",
    "contact": {
      "name": "Apify Partner Solutions",
      "url": "https://apify.com/deepaksheoran172/store-catalog-redirect-extractor",
      "email": "deepaksheoran172@apify.actor"
    },
    "x-rapidapi-pricing": {
      "type": "pay-per-use",
      "unitPrice": 0.05,
      "currency": "USD"
    }
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify Global Production API v2"
    }
  ],
  "security": [
    {
      "ApifyTokenHeader": []
    },
    {
      "ApifyTokenQuery": []
    }
  ],
  "paths": {
    "/acts/deepaksheoran172~store-catalog-redirect-extractor/run-sync-get-dataset-items": {
      "post": {
        "summary": "Synchronously execute store-catalog-redirect-extractor and retrieve output dataset items",
        "description": "Starts the Actor, waits for execution to complete, and directly returns the output dataset records as a JSON array. Recommended for RapidAPI integrations.",
        "operationId": "runSync_store_catalog_redirect_extractor",
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "description": "Maximum execution timeout in seconds (default 120)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 120
            }
          },
          {
            "name": "memory",
            "in": "query",
            "description": "Memory allocated in megabytes (default 1024)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1024
            }
          }
        ],
        "requestBody": {
          "description": "Actor configuration and runtime input parameters",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platform": {
                    "title": "Source Store Platform",
                    "type": "string",
                    "description": "Select the e-commerce platform of the source store ('shopify' or 'woocommerce').",
                    "enum": [
                      "shopify",
                      "woocommerce"
                    ],
                    "enumTitles": [
                      "Shopify (/products.json)",
                      "WooCommerce (/wp-json/wc/store/v1/products)"
                    ],
                    "default": "woocommerce",
                    "prefill": "woocommerce",
                    "editor": "select"
                  },
                  "storeUrl": {
                    "title": "Store URL",
                    "type": "string",
                    "description": "Public HTTP/HTTPS base URL of the source Shopify or WooCommerce store (e.g., https://example-store.com). Local file paths, credentials, and private/internal IPs are strictly blocked.",
                    "editor": "textfield",
                    "prefill": "https://example-store.com",
                    "pattern": "^https?://.+"
                  },
                  "maxPages": {
                    "title": "Max Pages",
                    "type": "integer",
                    "description": "Maximum number of catalogue pagination pages to fetch (1 to 50).",
                    "default": 5,
                    "prefill": 5,
                    "editor": "number",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "pageSize": {
                    "title": "Page Size",
                    "type": "integer",
                    "description": "Maximum number of products requested per page (up to 250 for Shopify; automatically capped at 100 for WooCommerce Store API v1).",
                    "default": 100,
                    "prefill": 100,
                    "editor": "number",
                    "minimum": 1,
                    "maximum": 250
                  },
                  "csvMode": {
                    "title": "CSV Formula Protection Mode",
                    "type": "string",
                    "description": "Controls spreadsheet formula neutralization: 'shopify_safe' (default, strips leading control characters and prepends a space before =, +, -, @ so Shopify imports remain clean) or 'spreadsheet_strict' (OWASP strict single-quote prefix).",
                    "enum": [
                      "shopify_safe",
                      "spreadsheet_strict"
                    ],
                    "enumTitles": [
                      "Shopify Safe (Clean Shopify Admin Import)",
                      "Spreadsheet Strict (OWASP Single-Quote Prefix)"
                    ],
                    "default": "shopify_safe",
                    "prefill": "shopify_safe",
                    "editor": "select"
                  }
                },
                "required": [
                  "platform",
                  "storeUrl"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Actor executed successfully; returns output items array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input schema parameters"
          },
          "401": {
            "description": "Unauthorized; valid Apify API token required"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/acts/deepaksheoran172~store-catalog-redirect-extractor/runs": {
      "post": {
        "summary": "Asynchronously start store-catalog-redirect-extractor background run",
        "description": "Queues an asynchronous Actor execution run on Apify Cloud and returns run status metadata.",
        "operationId": "runAsync_store_catalog_redirect_extractor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platform": {
                    "title": "Source Store Platform",
                    "type": "string",
                    "description": "Select the e-commerce platform of the source store ('shopify' or 'woocommerce').",
                    "enum": [
                      "shopify",
                      "woocommerce"
                    ],
                    "enumTitles": [
                      "Shopify (/products.json)",
                      "WooCommerce (/wp-json/wc/store/v1/products)"
                    ],
                    "default": "woocommerce",
                    "prefill": "woocommerce",
                    "editor": "select"
                  },
                  "storeUrl": {
                    "title": "Store URL",
                    "type": "string",
                    "description": "Public HTTP/HTTPS base URL of the source Shopify or WooCommerce store (e.g., https://example-store.com). Local file paths, credentials, and private/internal IPs are strictly blocked.",
                    "editor": "textfield",
                    "prefill": "https://example-store.com",
                    "pattern": "^https?://.+"
                  },
                  "maxPages": {
                    "title": "Max Pages",
                    "type": "integer",
                    "description": "Maximum number of catalogue pagination pages to fetch (1 to 50).",
                    "default": 5,
                    "prefill": 5,
                    "editor": "number",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "pageSize": {
                    "title": "Page Size",
                    "type": "integer",
                    "description": "Maximum number of products requested per page (up to 250 for Shopify; automatically capped at 100 for WooCommerce Store API v1).",
                    "default": 100,
                    "prefill": 100,
                    "editor": "number",
                    "minimum": 1,
                    "maximum": 250
                  },
                  "csvMode": {
                    "title": "CSV Formula Protection Mode",
                    "type": "string",
                    "description": "Controls spreadsheet formula neutralization: 'shopify_safe' (default, strips leading control characters and prepends a space before =, +, -, @ so Shopify imports remain clean) or 'spreadsheet_strict' (OWASP strict single-quote prefix).",
                    "enum": [
                      "shopify_safe",
                      "spreadsheet_strict"
                    ],
                    "enumTitles": [
                      "Shopify Safe (Clean Shopify Admin Import)",
                      "Spreadsheet Strict (OWASP Single-Quote Prefix)"
                    ],
                    "default": "shopify_safe",
                    "prefill": "shopify_safe",
                    "editor": "select"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Actor run queued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "actId": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "startedAt": {
                          "type": "string"
                        },
                        "defaultDatasetId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApifyTokenHeader": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Bearer <YOUR_APIFY_TOKEN>"
      },
      "ApifyTokenQuery": {
        "type": "apiKey",
        "name": "token",
        "in": "query",
        "description": "Apify Personal API Token parameter"
      }
    }
  }
}
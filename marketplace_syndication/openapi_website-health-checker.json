    "/acts/deepaksheoran172~website-health-checker/run-sync-get-dataset-items": {
      "post": {
        "summary": "Synchronously execute website-health-checker and retrieve output dataset items",
        "description": "Starts the Actor, waits for execution to complete, and directly returns the output dataset records as a JSON array. Recommended for RapidAPI integrations.",
        "operationId": "runSync_website_health_checker",
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "description": "Maximum execution timeout in seconds (default 120)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 120
            }
          },
          {
            "name": "memory",
            "in": "query",
            "description": "Memory allocated in megabytes (default 1024)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1024
            }
          }
        ],
        "requestBody": {
          "description": "Actor configuration and runtime input parameters",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "startUrl": {
                    "title": "Target Website URL",
                    "type": "string",
                    "description": "The initial website URL to crawl and audit for broken links, images, and health status.",
                    "editor": "textfield",
                    "prefill": "https://example.com"
                  },
                  "maxPages": {
                    "title": "Max Pages to Scan",
                    "type": "integer",
                    "description": "Maximum number of distinct internal pages to crawl (1 - 100).",
                    "editor": "number",
                    "default": 20,
                    "minimum": 1,
                    "maximum": 100
                  },
                  "timeout": {
                    "title": "Request Timeout (Seconds)",
                    "type": "number",
                    "description": "Timeout in seconds for each HTTP request.",
                    "editor": "number",
                    "default": 10.0,
                    "minimum": 1.0,
                    "maximum": 60.0
                  },
                  "delay": {
                    "title": "Polite Delay (Seconds)",
                    "type": "number",
                    "description": "Polite delay between consecutive requests to prevent target server rate limiting.",
                    "editor": "number",
                    "default": 0.5,
                    "minimum": 0.25,
                    "maximum": 5.0
                  },
                  "userAgent": {
                    "title": "User-Agent Header",
                    "type": "string",
                    "description": "Custom User-Agent header string sent with HTTP requests.",
                    "editor": "textfield",
                    "default": "WebsiteHealthChecker/1.0 (Apify Actor)"
                  }
                },
                "required": [
                  "startUrl"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Actor executed successfully; returns output items array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input schema parameters"
          },
          "401": {
            "description": "Unauthorized; valid Apify API token required"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },

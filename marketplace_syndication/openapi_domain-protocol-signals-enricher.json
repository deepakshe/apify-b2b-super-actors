  "paths": {
    "/acts/deepaksheoran172~domain-protocol-signals-enricher/run-sync-get-dataset-items": {
      "post": {
        "summary": "Synchronously execute domain-protocol-signals-enricher and retrieve output dataset items",
        "description": "Starts the Actor, waits for execution to complete, and directly returns the output dataset records as a JSON array. Recommended for RapidAPI integrations.",
        "operationId": "runSync_domain_protocol_signals_enricher",
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "description": "Maximum execution timeout in seconds (default 120)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 120
            }
          },
          {
            "name": "memory",
            "in": "query",
            "description": "Memory allocated in megabytes (default 1024)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1024
            }
          }
        ],
        "requestBody": {
          "description": "Actor configuration and runtime input parameters",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domains": {
                    "title": "Domains to Probe",
                    "type": "array",
                    "description": "List of domain names or hostnames to probe for well-known protocol and app association signals.",
                    "editor": "stringList",
                    "prefill": [
                      "stripe.com",
                      "shopify.com",
                      "example.com"
                    ]
                  },
                  "probe_app_links": {
                    "title": "Probe Mobile App Links",
                    "type": "boolean",
                    "description": "Probe /.well-known/assetlinks.json (Android Digital Asset Links) and /.well-known/apple-app-site-association (iOS AASA Universal Links).",
                    "default": true
                  },
                  "probe_identity_metadata": {
                    "title": "Probe Identity Metadata",
                    "type": "boolean",
                    "description": "Probe /.well-known/openid-configuration and /.well-known/oauth-authorization-server metadata.",
                    "default": true
                  },
                  "probe_security_policies": {
                    "title": "Probe Security Policies",
                    "type": "boolean",
                    "description": "Probe RFC 9116 /.well-known/security.txt and RFC 8461 /.well-known/mta-sts.txt.",
                    "default": true
                  },
                  "probe_domain_files": {
                    "title": "Probe Domain Verification & LLM Files",
                    "type": "boolean",
                    "description": "Probe /.well-known/apple-developer-merchantid-domain-association, /llms.txt, and /.well-known/atproto-did.",
                    "default": true
                  },
                  "concurrency": {
                    "title": "Concurrency",
                    "type": "integer",
                    "description": "Maximum number of domains to probe concurrently.",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 20
                  },
                  "request_timeout_secs": {
                    "title": "Request Timeout (Seconds)",
                    "type": "integer",
                    "description": "Maximum timeout in seconds for each HTTP probe request.",
                    "default": 10,
                    "minimum": 3,
                    "maximum": 30
                  },
                  "max_domains": {
                    "title": "Max Domains Limit",
                    "type": "integer",
                    "description": "Safety cap on the maximum number of domains processed per run.",
                    "default": 500,
                    "minimum": 1,
                    "maximum": 5000
                  }
                },
                "required": [
                  "domains"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Actor executed successfully; returns output items array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input schema parameters"
          },
          "401": {
            "description": "Unauthorized; valid Apify API token required"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/acts/deepaksheoran172~domain-protocol-signals-enricher/runs": {
      "post": {
        "summary": "Asynchronously start domain-protocol-signals-enricher background run",
        "description": "Queues an asynchronous Actor execution run on Apify Cloud and returns run status metadata.",
        "operationId": "runAsync_domain_protocol_signals_enricher",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domains": {
                    "title": "Domains to Probe",
                    "type": "array",
                    "description": "List of domain names or hostnames to probe for well-known protocol and app association signals.",
                    "editor": "stringList",
                    "prefill": [
                      "stripe.com",
                      "shopify.com",
                      "example.com"
                    ]
                  },
                  "probe_app_links": {
                    "title": "Probe Mobile App Links",
                    "type": "boolean",
                    "description": "Probe /.well-known/assetlinks.json (Android Digital Asset Links) and /.well-known/apple-app-site-association (iOS AASA Universal Links).",
                    "default": true
                  },
                  "probe_identity_metadata": {
                    "title": "Probe Identity Metadata",
                    "type": "boolean",
                    "description": "Probe /.well-known/openid-configuration and /.well-known/oauth-authorization-server metadata.",
                    "default": true
                  },
                  "probe_security_policies": {
                    "title": "Probe Security Policies",
                    "type": "boolean",
                    "description": "Probe RFC 9116 /.well-known/security.txt and RFC 8461 /.well-known/mta-sts.txt.",
                    "default": true
                  },
                  "probe_domain_files": {
                    "title": "Probe Domain Verification & LLM Files",
                    "type": "boolean",
                    "description": "Probe /.well-known/apple-developer-merchantid-domain-association, /llms.txt, and /.well-known/atproto-did.",
                    "default": true
                  },
                  "concurrency": {
                    "title": "Concurrency",
                    "type": "integer",
                    "description": "Maximum number of domains to probe concurrently.",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 20
                  },
                  "request_timeout_secs": {
                    "title": "Request Timeout (Seconds)",
                    "type": "integer",
                    "description": "Maximum timeout in seconds for each HTTP probe request.",
                    "default": 10,
                    "minimum": 3,
                    "maximum": 30
                  },
                  "max_domains": {
                    "title": "Max Domains Limit",
                    "type": "integer",
                    "description": "Safety cap on the maximum number of domains processed per run.",
                    "default": 500,
                    "minimum": 1,
                    "maximum": 5000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Actor run queued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "actId": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "startedAt": {
                          "type": "string"
                        },
                        "defaultDatasetId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
